# Quick navigation helpers
cdtarget() {
    if [ -z "$1" ]; then
        cd "${HUNT_BASE}" || return 1
    else
        cd "${HUNT_BASE}/$1" || return 1
    fi
}

# Tab completion for cdtarget
if [ -n "$BASH_VERSION" ]; then
    _cdtarget_complete() {
        local cur="${COMP_WORDS[COMP_CWORD]}"
        if [ -d "${HUNT_BASE}" ]; then
            COMPREPLY=($(cd "${HUNT_BASE}" && compgen -d -- "$cur"))
        fi
    }
    complete -F _cdtarget_complete cdtarget
elif [ -n "$ZSH_VERSION" ]; then
    _cdtarget_complete() {
        local -a targets
        if [ -d "${HUNT_BASE}" ]; then
            targets=(${HUNT_BASE}/*(/:t))
            _describe 'targets' targets
        fi
    }
    compdef _cdtarget_complete cdtarget
fi

# BBForge banner (optional - shown on new shell)
if [ "${BB_SHOW_BANNER:-0}" = "1" ]; then
    echo "🔥 BBForge workflows loaded. Type 'bb-help' for available commands."
fi
