# Environment variables
export HUNT_BASE="${HOME}/Targets"
export BB_SCRIPTS_DIR="${HOME}/Documents/BBForge-Scripts"
export PATH="${BB_SCRIPTS_DIR}:${PATH}"

# Core workflow aliases
alias hunt='${BB_SCRIPTS_DIR}/hunt.sh'
alias bb-recon='${BB_SCRIPTS_DIR}/recon_engine.sh'
alias bb-scan='${BB_SCRIPTS_DIR}/vuln_scanner.sh'
alias bb-arsenal='${BB_SCRIPTS_DIR}/external_arsenal.sh'

# Specialized scanner aliases
alias bb-secrets='${BB_SCRIPTS_DIR}/secrets_hunter.sh'
alias bb-cloud='${BB_SCRIPTS_DIR}/cloud_recon.sh'
alias bb-403='${BB_SCRIPTS_DIR}/bypass_403.sh'
alias bb-takeover='${BB_SCRIPTS_DIR}/takeover_scanner.sh'
alias bb-params='${BB_SCRIPTS_DIR}/param_discovery.sh'
alias bb-cves='${BB_SCRIPTS_DIR}/cve_scan.sh'
alias bb-scope='${BB_SCRIPTS_DIR}/scope_aggregator.sh'

